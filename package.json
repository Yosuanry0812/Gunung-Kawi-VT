{
  "name": "gunung-kawi-project",
  "version": "1.0.0",
  "private": true,
  "description": "Command launcher for the Gunung Kawi website project.",
  "scripts": {
    "ai:setup": "node .hooks/codex-setup.mjs",
    "ai:hooks": "node .hooks/codex-setup.mjs --check",
    "ai:check": "node .hooks/ai-context.mjs check",
    "ai:finish": "node .hooks/ai-context.mjs finish",
    "ai:test": "node --test .hooks/ai-context.test.mjs",
    "dev": "npm --prefix 01-gunung-kawi-web run dev --",
    "install:web": "npm --prefix 01-gunung-kawi-web ci"
  }
}
